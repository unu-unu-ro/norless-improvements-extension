{
  "name": "Norless improvements",
  "version": "2.2.0",
  "description": "Norless improvements for Projecting Church songs. Sync with [Project verses from bible.com] Extension ✨",
  "manifest_version": 3,
  "author": "Matei Nicolae",
  "background": {
    "service_worker": "views/background.js"
  },
  "action": {
    "default_popup": "views/popup/popup.html",
    "default_title": "Norless improvements"
  },
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "host_permissions": ["http://app.norless.com/*", "http://app-ua.norless.com/*"],
  "content_scripts": [
    {
      "matches": ["http://*.norless.com/*"],
      "js": [
        "views/icons/icons.js",
        "views/common/utilities.js",
        "views/common/tooltip/tooltip.js",
        "views/common/simplePrompt/simplePrompt.js",
        "views/common/toast/toast.js"
      ],
      "css": [
        "views/common/colors.css",
        "views/common/tooltip/tooltip.css",
        "views/common/simplePrompt/simplePrompt.css",
        "views/common/actions.css",
        "views/common/toast/toast.css"
      ],
      "run_at": "document_end"
    },

    {
      "matches": ["http://app.norless.com/*"],
      "js": [
        "views/norless/storage.js",
        "views/norless/selectors.js",
        "views/norless/print.js",
        "views/norless/bible-verses-integration.js",
        "views/norless/index.js",
        "views/norless/sync.js"
      ]
    },
    {
      "matches": ["http://app.norless.com/template/output.html"],
      "css": ["views/norless/output-overrides.css"],
      "js": ["views/norless/runtime-messages.js", "views/norless/bible-verses-integration.js"]
    },

    {
      "matches": ["http://app-ua.norless.com/*"],
      "js": [
        "views/norless/storage.js",
        "views/norless/selectors.js",
        "views/norless/print.js",
        "views/norless/bible-verses-integration.js",
        "views/norless/index.js",
        "views/norless/sync.js"
      ]
    },
    {
      "matches": ["http://app-ua.norless.com/template/output.html"],
      "css": ["views/norless/output-overrides.css"],
      "js": ["views/norless/runtime-messages.js", "views/norless/bible-verses-integration.js"]
    }
  ],
  "icons": {
    "16": "views/icons/icon-16.png",
    "48": "views/icons/icon-48.png",
    "128": "views/icons/icon-128.png"
  }
}
